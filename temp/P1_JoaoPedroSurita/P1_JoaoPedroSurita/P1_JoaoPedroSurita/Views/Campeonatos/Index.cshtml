@model IEnumerable<CampeonatosViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Campeonato de Robótica</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Novo Campeonato
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Nome do Evento</th>
                        <th class="text-center">Arena</th>
                        <th class="text-center">Limite de Participantes</th>
                        <th class="text-center">Quantidade de Robôs</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.NomeEvento</strong></td>
                            <td class="text-center">@item.QuantidadeRobos</td>
                            <td class="text-center">@item.Arena</td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Alterar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Alterar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Tem certeza que deseja excluir este campeonato?')">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>