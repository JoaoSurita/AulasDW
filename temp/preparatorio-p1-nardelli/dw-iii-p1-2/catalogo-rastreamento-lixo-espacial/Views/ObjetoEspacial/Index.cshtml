@model IEnumerable<ObjetoEspacialViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2 class="text-info">Monitoramento Orbital</h2>
        <a asp-action="Create" class="btn btn-primary">Novo Objeto</a>
    </div>

    <table class="table table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>NoradId</th>
                <th>Tipo</th>
                <th>Última Altitude (km)</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.NoradId</td>
                    <td><span class="badge bg-secondary">@item.TipoObjeto</span></td>
                    <td class="fw-bold">@item.UltimaAltitude.ToString("N2") km</td>
                    <td>
                        <a asp-action="AtualizarTelemetria" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Telemetria</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Excluir objeto?')">Remover</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>