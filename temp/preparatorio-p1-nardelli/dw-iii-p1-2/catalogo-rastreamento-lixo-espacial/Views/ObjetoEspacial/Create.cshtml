@model ObjetoEspacial
<div class="container mt-4 col-md-6">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">Cadastrar Objeto Espacial</div>
        <div class="card-body">
            <form asp-action="Create">
                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">NoradId</label>
                    <input asp-for="NoradId" type="number" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Tipo de Objeto</label>
                    <select asp-for="TipoObjeto" class="form-select">
                        <option value="Satélite">Satélite</option>
                        <option value="Lixo Espacial">Lixo Espacial</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-success w-100">Salvar Objeto</button>
            </form>
        </div>
    </div>
</div>