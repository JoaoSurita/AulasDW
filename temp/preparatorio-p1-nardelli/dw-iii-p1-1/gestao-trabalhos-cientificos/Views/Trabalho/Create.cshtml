@model Trabalho

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-primary shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Submissão de Trabalho</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label">Título do Trabalho</label>
                            <input asp-for="Titulo" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="AreaTematica" class="form-label">Área Temática</label>
                            <select asp-for="AreaTematica" class="form-select">
                                <option value="Tecnologia">Tecnologia</option>
                                <option value="Saúde">Saúde</option>
                                <option value="Humanas">Humanas</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Resumo" class="form-label">Resumo</label>
                            <textarea asp-for="Resumo" class="form-control" rows="3" required></textarea>
                        </div>

                        <h5 class="mt-4 border-bottom pb-2">Dados dos Autores</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="small fw-bold">Autor 1 (Obrigatório)</label>
                                <input name="Autores[0].Nome" class="form-control mb-2" placeholder="Nome" required />
                                <input name="Autores[0].Email" type="email" class="form-control" placeholder="E-mail" required />
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold">Autor 2 (Opcional)</label>
                                <input name="Autores[1].Nome" class="form-control mb-2" placeholder="Nome" />
                                <input name="Autores[1].Email" type="email" class="form-control" placeholder="E-mail" />
                            </div>
                        </div>

                        <div class="mt-4 d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Finalizar Cadastro</button>
                            <a asp-action="Index" class="btn btn-link text-secondary">Voltar para a lista</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>