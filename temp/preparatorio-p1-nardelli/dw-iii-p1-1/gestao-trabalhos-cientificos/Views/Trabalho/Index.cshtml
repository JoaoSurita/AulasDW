@model IEnumerable<TrabalhoViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Trabalhos Acadêmicos</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Novo Trabalho
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Título</th>
                        <th>Área Temática</th>
                        <th class="text-center">Autores</th>
                        <th class="text-center">Média</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Titulo</strong></td>
                            <td><span class="badge bg-secondary">@item.AreaTematica</span></td>
                            <td class="text-center">@item.QuantidadeAutores</td>
                            <td class="text-center">
                                <span class="fw-bold @(item.MediaNotas >= 3 ? "text-success" : "text-danger")">
                                    @item.MediaNotas.ToString("F1")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Avaliar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Avaliar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Deseja excluir este trabalho?')">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>